# Normalize all text files to LF in the repo and the working tree: the same
# worktree is shared between Windows and the Linux dev container, and
# Spotless (git-aware line endings) plus core.autocrlf=true kept flipping
# every file between CRLF and LF.
* text=auto eol=lf

# LF for devcontainer assets so scripts/config parse inside the Linux container.
.devcontainer/** text eol=lf
*.sh text eol=lf
gradlew text eol=lf
